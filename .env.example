# PostgreSQL Configuration Example
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_password
DB_NAME=postgresql_instance
DB_SSL=false

# Optional connection string
# DATABASE_URL=postgresql://postgres:password@localhost:5432/postgresql_instance

# Backend Server Port
PORT=5000

# ==========================================================
# Google OAuth 2.0 (Single Sign-On SSO)
# ==========================================================
# Google Client ID lấy từ Google Cloud Console (APIs & Services > Credentials > OAuth 2.0 Client IDs)
GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com

# Chuỗi bí mật ký Session Token JWT (Nên đặt chuỗi ngẫu nhiên dài, phức tạp)
JWT_SECRET=your_jwt_secret_key_change_in_production
